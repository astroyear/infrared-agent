# 在项目根目录复制为 .env
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选，填写三项以启用兼容 OpenAI 的 Embedding 服务
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Compose 数据库密码，请使用随机字母数字字符串
POSTGRES_PASSWORD=
FRONTEND_PORT=8080
